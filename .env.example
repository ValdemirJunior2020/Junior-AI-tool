# Copy to .env. Never commit secrets.
PORT=3001
NODE_ENV=development
PUBLIC_URL=http://localhost:3001
DATA_DIR=./data
OLLAMA_URL=http://127.0.0.1:11434
# Require local Fooocus-API adapter and compatible AMD DirectML setup.
ENABLE_FOOOCUS=false
FOOOCUS_API_URL=http://127.0.0.1:8888
# Public registration is deliberately blocked until SMTP verification works.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
