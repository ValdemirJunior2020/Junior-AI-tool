# Copy to .env. Never commit secrets.
PORT=3001
NODE_ENV=development
PUBLIC_URL=http://localhost:3001
DATA_DIR=./data
OLLAMA_URL=http://127.0.0.1:11434
# Local administrator bootstrap and official Fooocus AMD settings (no third-party API keys).
# Keep this file ONLY on your PC. Run npm run admin:env once to hash it into SQLite.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Official Fooocus Windows portable directory (contains python_embeded and Fooocus folders).
# Example: C:\AI\Fooocus_win64_2-5-0
FOOOCUS_DIR=
# Original Fooocus Gradio web interface - localhost only.
FOOOCUS_UI_URL=http://127.0.0.1:7865
ENABLE_FOOOCUS=false
# Public image access stays disabled until robust local image moderation is deployed.
ALLOW_PUBLIC_IMAGES=false
# Autonomous OpenHands builder is super-admin/local-browser-only, disabled until set up.
ENABLE_SOFTWARE_BUILDER=false
OPENHANDS_MODEL=qwen2.5-coder:7b
# This URL must work INSIDE Ubuntu WSL; never point it at a public server.
OPENHANDS_OLLAMA_URL=http://127.0.0.1:11434/v1
# Account creation requires only email and password; no SMTP verification is required.
# SMTP is optional and only needed for email-based password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
